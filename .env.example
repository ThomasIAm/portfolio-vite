# Copy to .env for local development.
# When true, `scripts/fetch-content.mjs` copies `blog-posts.sample.json` into place
# and does NOT attempt to reach Contentful. Cloudflare Pages sets this to `false`
# and provides the Contentful credentials below, and the build fails if Contentful
# is unreachable.
USE_SAMPLE_CONTENT=true

# Required when USE_SAMPLE_CONTENT=false
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
# Optional: use the Preview API instead of the Delivery API
CONTENTFUL_PREVIEW_TOKEN=